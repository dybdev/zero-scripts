# Use "mock" until your Tebex Headless API store is ready.
TEBEX_DATA_SOURCE=mock

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
TEBEX_WEBSTORE_TOKEN=
TEBEX_PRIVATE_KEY=
TEBEX_API_BASE_URL=https://headless.tebex.io/api

# Absolute public URL used for basket completion and cancellation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord Developer Portal OAuth2 application. Add this exact redirect URL:
# http://localhost:3000/api/auth/discord/callback (and the production equivalent)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional community link used by the signed-in user dropdown.
NEXT_PUBLIC_DISCORD_URL=

# Public customer-support email shown on the support and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
